{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Casino Blackjack",
  "version": "0.1.0",
  "identifier": "com.wpm.casinoblackjack",
  "build": {
    "beforeDevCommand": "cd blackjack-ui && trunk serve",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "cd blackjack-ui && trunk build --release",
    "frontendDist": "../blackjack-ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Casino Blackjack",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
